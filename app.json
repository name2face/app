{
  "expo": {
    "name": "Name2Face",
    "slug": "Name2FaceApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/name2face-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/name2face-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.name2face.Name2FaceApp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/name2face-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.name2face.Name2FaceApp",
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "52b51aa3-1497-4cda-bab4-375ba12ab90e"
      }
    },
    "plugins": ["expo-sqlite", "expo-document-picker", "expo-system-ui"]
  }
}
